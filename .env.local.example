# Copy this file to .env.local and fill in your two endpoints.
# .env.local is gitignored — tokens never get committed.
# Do not add a trailing /v1 to the endpoints; the app appends it.

ORA_ENDPOINT=https://<your-compressed-model-endpoint>
ORA_TOKEN=<token>

STOCK_ENDPOINT=https://<your-baseline-model-endpoint>
STOCK_TOKEN=<token>

# Optional — the model name each endpoint expects.
# Defaults below; only set these if your endpoints serve different names.
# ORA_MODEL_NAME=qwen3-4b-ora
# STOCK_MODEL_NAME=qwen3-4b
